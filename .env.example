# Generate a long random key locally. Never paste it into chat or GitHub.
APP_API_KEY=
DATABASE_URL=sqlite:///runtime/churn.db
PORT=8000

# LLM provider (server only). Groq is the default; set the key in Render Environment.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Alternative provider: LLM_PROVIDER=gemini plus these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Provider attempts per service/day and public analyses requesting LLM per day.
LLM_DAILY_LIMIT=50
PUBLIC_LLM_DAILY_LIMIT=10
